[global]
  monitor = 0
  follow = mouse
  width = 300
  origin = top-right
  offset = (10,20)
  indicate_hidden = yes
  shrink = no
  separator_height = 5
  padding = 8
  horizontal_padding = 8
  frame_width = 2
  sort = yes
  idle_threshold = 120
  font = FiraMono Nerd Font 11
  line_height = 0
  markup = full
  format = "<b>%s</b>\n%b"
  alignment = left
  vertical_alignment = center
  show_age_threshold = 60
  word_wrap = yes
  ellipsize = middle
  ignore_newline = no
  stack_duplicates = true
  hide_duplicate_count = false
  show_indicators = yes
  icon_position = left
  min_icon_size = 0
  max_icon_size = 32
  sticky_history = yes
  history_length = 100
  always_run_script = true
  corner_radius = 5

[urgency_low]
  background = "#282A36"
  foreground = "#F8F8F2"
  frame_color = "#6272A4"
  timeout = 15

[urgency_normal]
  background = "#282A36"
  foreground = "#F8F8F2"
  frame_color = "#BD93F9"
  timeout = 15

[urgency_critical]
  background = "#FF5555"
  foreground = "#F8F8F2"
  frame_color = "#FF5555"
  timeout = 0
