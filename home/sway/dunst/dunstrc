[global]
  monitor = 0
  follow = mouse
  geometry = "300x5-6+35"
  indicate_hidden = yes
  shrink = no
  separator_height = 5
  padding = 8
  horizontal_padding = 8
  sort = yes
  idle_threshold = 120
  font = FiraMono Nerd Font 10
  line_height = 0
  markup = full
  format = "<b>%s</b>\n%b"
  alignment = left
  vertical_alignment = center
  show_age_threshold = 60
  word_wrap = yes
  ellipsize = middle
  ignore_newline = no
  stack_duplicates = true
  hide_duplicate_count = false
  show_indicators = yes
  icon_position = left
  min_icon_size = 0
  max_icon_size = 32
  sticky_history = yes
  history_length = 100
  always_run_script = true
  title = Dunst
  class = Dunst
  startup_notification = false
  verbosity = mesg
  corner_radius = 5
  mouse_left_click = close_current
  mouse_middle_click = do_action, close_current
  mouse_right_click = close_all

[shortcuts]
  close = ctrl+space
  close_all = ctrl+shift+space
  context = ctrl+shift+period

[urgency_low]
  background = "#2E3440"
  foreground = "#ECEFF4"
  timeout = 15

[urgency_normal]
  background = "#2E3440"
  foreground = "#ECEFF4"
  timeout = 15

[urgency_critical]
  background = "#BF616A"
  foreground = "#ECEFF4"
  frame_color = "#ff0000"
  timeout = 0
